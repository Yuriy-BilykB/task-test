generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id         String            @id @default(cuid())
  name  String @unique
  todos Todo[]
}

model Todo {
  id         String            @id @default(cuid())
  text       String
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String


  @@index([categoryId])
}
